<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controladores.MainController"
            prefHeight="700.0" prefWidth="1000.0">

    <left>
        <VBox spacing="15.0" style="-fx-background-color: #f4f4f4; -fx-border-color: #cccccc; -fx-border-width: 0 1 0 0;">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="Gestión de Rutas" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Separator />

            <Label text="Origen:"/>
            <ComboBox fx:id="comboOrigen" prefWidth="200.0" promptText="Seleccione partida..."/>

            <Label text="Destino:"/>
            <ComboBox fx:id="comboDestino" prefWidth="200.0" promptText="Seleccione destino..."/>

            <Label text="Optimizar por:"/>
            <ComboBox fx:id="comboCriterio" prefWidth="200.0" promptText="Seleccione criterio..."/>

            <Button fx:id="btnCalcular" text="Calcular Ruta Óptima" prefWidth="200.0"
                    style="-fx-background-color: #0078D7; -fx-text-fill: white; -fx-font-weight: bold;"
                    onAction="#calcularRuta"/>

            <Separator />

            <Label text="Algoritmo Alternativo:"/>
            <ComboBox fx:id="comboAlgoritmo" prefWidth="200.0" promptText="Seleccione algoritmo..."/>

            <Button fx:id="btnCalcularAlternativa" text="Calcular Alternativa" prefWidth="200.0"
                    style="-fx-background-color: #FF8C00; -fx-text-fill: white; -fx-font-weight: bold;"
                    onAction="#calcularRutaAlternativa"/>

            <Separator />
            <Button text="Gestionar Paradas/Rutas" prefWidth="200.0" onAction="#abrirGestor"/>
        </VBox>
    </left>

    <center>
        <Pane fx:id="mapaPane" style="-fx-background-color: #ffffff;">
        </Pane>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="20.0" style="-fx-padding: 15; -fx-background-color: #f4f4f4; -fx-border-color: #cccccc; -fx-border-width: 1 0 0 0;">
            <children>
                <Label fx:id="lblTiempo" style="-fx-font-weight: bold;" text="Tiempo: 0 min" />
                <Label fx:id="lblCosto" style="-fx-font-weight: bold;" text="Costo: $0.00" />
                <Label fx:id="lblDistancia" style="-fx-font-weight: bold;" text="Distancia: 0 km" />

                <Label fx:id="lblTransbordos" style="-fx-font-weight: bold;" text="Transbordos: 0" />
            </children>
        </HBox>
    </bottom>

</BorderPane>